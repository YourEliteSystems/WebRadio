    <release version="1.0.6-beta.3" date="2026-09-07">
      <description>
        <p>Bugfixes for Discord RPC, Plugin Fingerprinting and EventBus as well as comprehensive regression tests.</p>
      </description>
    </release>
  </releases>
  <categories>
