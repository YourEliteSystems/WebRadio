# Maintainer: Your Elite Systems <contact@yourelitesystems.com>
# Contributor: WebRadio Community

# WebRadio wird über electron-builder als AppImage erzeugt.
# Dieser PKGBUILD nimmt das fertige AppImage, entpackt es in einen
# echten /opt/-Installationsbaum und verpackt ihn mit makepkg.
# Damit ist die Distribution vollständig:
#   • Eigenes Icon (hicolor)
#   • .desktop-Datei
#   • Symlink /usr/bin/webradio → /opt/webradio/webradio
#   • Keine Abhängigkeit von node, npm, electron oder ffmpeg
#     auf dem Zielsystem – alles ist im Paket enthalten.
#
# Hinweis zur Versionierung – strikte Trennung:
#
#   pkgver      Arch-Paketversion. Darf laut Arch-Policy KEINE Bindestriche
#               enthalten: 1.0.7-alpha.5 (SemVer) → 1.0.7.alpha.5
#   _semver     Original-SemVer aus package.json. Ausschließlich für die
#               Anzeige (pkgdesc) – niemals für Dateinamen.
#   _appimage   Dateiname des von electron-builder erzeugten AppImage-Artefakts.
#               Der Wert wird vom Build-Schritt mit dem tatsächlichen Dateinamen
#               gesetzt (Variable _appimage) und NIE aus pkgver oder _semver
#               rekonstruiert. Schreibweise, Bindestriche und
#               Groß-/Kleinschreibung des Artefakts bleiben dadurch erhalten.

pkgname=webradio
_pkgname=webradio
pkgver=__PKGVER__
pkgrel=1
_semver=__SEMVER__
# Name der AppImage-Quelldatei – tatsächlicher Artefaktname aus dem Build.
# Bewusst NICHT aus pkgver/_semver zusammengesetzt.
_appimage="__APPIMAGE_FILE__"
pkgdesc="Modern desktop radio player with plugin system (v${_semver})"
arch=('x86_64')
url="https://github.com/YourEliteSystems/WebRadio"
license=('Apache-2.0')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gcc-libs'
  'glib2'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libdrm'
  'libnotify'
  'libsecret'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'xdg-utils'
)
optdepends=(
  'libpulse: PulseAudio support'
  'pipewire-pulse: PipeWire (Pulse) support'
  'noto-fonts: broader glyph coverage'
)
makedepends=(
  'fakeroot'
  'squashfs-tools'
  'unzip'
)
provides=('webradio')
conflicts=('webradio-bin' 'webradio-git')
options=('!strip')

# Die Quell-Dateien liegen bereits im Build-Verzeichnis (werden vom
# CI-Skript bzw. scripts/build-linux-arch.js vor makepkg dorthin kopiert).
# Das AppImage wird dabei unter seinem tatsächlichen Artefaktnamen abgelegt –
# kein Namensschema, das aus einer Version rekonstruiert wird.
source=(
  "${_appimage}"
  "webradio.desktop"
  "tray.png"
)
sha256sums=(
  '__APPIMAGE_SHA256__'
  '__DESKTOP_SHA256__'
  '__ICON_SHA256__'
)

# KEIN prepare() / build() – wir entpacken das AppImage und kopieren
# die bereits gebauten Dateien. Das vermeidet eine zweite Electron-
# Build-Pipeline und garantiert, dass die ausgelieferte Binary
# identisch zum AppImage-Build ist.

package() {
  # 1) AppImage in ein Arbeitsverzeichnis entpacken.
  #    Verwendet wird ausschließlich der tatsächliche Artefaktname ($_appimage);
  #    der Dateiname wird an keiner Stelle aus pkgver oder _semver gebildet.
  cd "$srcdir"
  mkdir -p appimage-extract
  chmod +x "$srcdir/${_appimage}"
  # Wichtig: --appimage-extract legt squashfs-root im AKTUELLEN Arbeitsverzeichnis
  # ab. Deshalb die Extraktion innerhalb von appimage-extract durchfuehren, damit
  # das Ergebnis unter $srcdir/appimage-extract/squashfs-root landet (nicht in
  # $srcdir selbst, wo es vom Code unten nicht gefunden wuerde).
  # --no-sandbox, damit das Entpacken auch in CI-Containern ohne
  # Kernel-Sandbox-Erweiterungen funktioniert.
  if ! ( cd "$srcdir/appimage-extract" && "$srcdir/${_appimage}" --appimage-extract >/dev/null 2>&1 ); then
    # Fallback: manuell entpacken (benoetigt nur squashfs-tools + unzip).
    # Der Artefaktname wird als Argument uebergeben - keine String-Interpolation
    # eines Versionsstrings in den Dateinamen.
    (
      cd "$srcdir/appimage-extract" || exit 1
      offset=$("$srcdir/${_appimage}" --appimage-offset 2>/dev/null || echo 0)
      tail -c +$((offset + 1)) "$srcdir/${_appimage}" | unsquashfs -d squashfs-root - >/dev/null 2>&1
    )
  fi

  # Defensiv: falls die Extraktion squashfs-root doch in $srcdir abgelegt hat.
  if [ -d "$srcdir/squashfs-root" ] && [ ! -d "$srcdir/appimage-extract/squashfs-root" ]; then
    mv "$srcdir/squashfs-root" "$srcdir/appimage-extract/"
  fi

  # Hart abbrechen, statt ein leeres Paket zu erzeugen.
  if [ ! -d "$srcdir/appimage-extract/squashfs-root" ]; then
    echo "ERROR: AppImage-Extraktion fehlgeschlagen - squashfs-root fehlt." >&2
    ls -la "$srcdir" "$srcdir/appimage-extract" >&2 || true
    exit 1
  fi

  # 2) Installations-Verzeichnisbaum anlegen.
  install -dm755 "$pkgdir/opt/${_pkgname}"

  # 3) AppImage-Inhalt nach /opt/webradio kopieren.
  #    Wir nehmen den vollständigen squashfs-root-Inhalt – so bleibt
  #    die Binary lauffähig (eigene libs, ASAR, FFmpeg etc.).
  if [ -d "$srcdir/appimage-extract/squashfs-root" ]; then
    cp -a "$srcdir/appimage-extract/squashfs-root/." "$pkgdir/opt/${_pkgname}/"
  else
    # Ältere AppImage-Versionen entpacken direkt.
    cp -a "$srcdir/appimage-extract/." "$pkgdir/opt/${_pkgname}/"
  fi

  # Verzeichnisse absichern: 755
  find "$pkgdir/opt/${_pkgname}" -type d -exec chmod 755 {} +

  # Standard-Dateirechte für statische Daten: 644 (keine globalen Schreibrechte, kein chmod 777)
  find "$pkgdir/opt/${_pkgname}" -type f -exec chmod 644 {} +

  # Die Hauptbinary ermitteln und ausführbar machen (chmod 755).
  # electron-builder erzeugt je nach Konfiguration "webradio" oder "WebRadio".
  _bin_name=""
  if [ -f "$pkgdir/opt/${_pkgname}/webradio" ]; then
    _bin_name="webradio"
  elif [ -f "$pkgdir/opt/${_pkgname}/WebRadio" ]; then
    _bin_name="WebRadio"
  fi

  if [ -n "$_bin_name" ]; then
    chmod 755 "$pkgdir/opt/${_pkgname}/${_bin_name}"
  fi

  # Chromium/Electron SUID-Sandbox Helper benötigt SUID-Root bzw. 4755 auf Linux
  if [ -f "$pkgdir/opt/${_pkgname}/chrome-sandbox" ]; then
    chmod 4755 "$pkgdir/opt/${_pkgname}/chrome-sandbox"
  fi

  # Electron Crashpad Handler ausführbar machen
  if [ -f "$pkgdir/opt/${_pkgname}/chrome_crashpad_handler" ]; then
    chmod 755 "$pkgdir/opt/${_pkgname}/chrome_crashpad_handler"
  fi

  # Shared Libraries (.so) und native Module (.node) bleiben 644 (nicht ausführbar),
  # da sie per dlopen geladen werden und keine Ausführungsrechte benötigen.

  # FFmpeg-Binaries in resources und asar.unpacked ausführbar machen
  if [ -d "$pkgdir/opt/${_pkgname}/resources" ]; then
    find "$pkgdir/opt/${_pkgname}/resources" -type f -name 'ffmpeg*' -exec chmod 755 {} + 2>/dev/null || true
  fi
  # ASAR-unpacked FFmpeg (falls vorhanden)
  if [ -d "$pkgdir/opt/${_pkgname}/resources/app.asar.unpacked" ]; then
    find "$pkgdir/opt/${_pkgname}/resources/app.asar.unpacked" -type f -name 'ffmpeg*' -exec chmod 755 {} + 2>/dev/null || true
  fi

  # 4) Symlink /usr/bin/webradio → /opt/webradio/<binary>
  install -dm755 "$pkgdir/usr/bin"
  if [ -n "$_bin_name" ]; then
    ln -s "/opt/${_pkgname}/${_bin_name}" "$pkgdir/usr/bin/${_pkgname}"
  else
    # Fallback falls zur statischen Analyse/Build-Zeit noch nicht aufgelöst
    ln -s "/opt/${_pkgname}/WebRadio" "$pkgdir/usr/bin/${_pkgname}"
  fi

  # 5) .desktop-Datei installieren.
  install -Dm644 "$srcdir/webradio.desktop" "$pkgdir/usr/share/applications/webradio.desktop"

  # 6) Icon in mehreren Standardgrößen installieren.
  #    Wir haben ein 256x256 PNG; electron-builder liefert die anderen
  #    Größen über die Hicon-Skala. Für Arch reicht 256x256 als Default.
  for size in 16 32 48 64 128 256 512; do
    install -Dm644 "$srcdir/tray.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/webradio.png"
  done

  # 7) Lizenz
  if [ -f "$pkgdir/opt/${_pkgname}/LICENSE" ]; then
    install -Dm644 "$pkgdir/opt/${_pkgname}/LICENSE" \
      "$pkgdir/usr/share/licenses/${_pkgname}/LICENSE"
  fi
}
