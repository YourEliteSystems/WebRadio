{
  "name": "webradio",
  "version": "1.0.4",
  "description": "Plattformübergreifende WebRadio-App mit Electron",
  "main": "electron/main.js",
  "author": "Your Elite Systms",
  "scripts": {
    "start": "npm run build-react && electron-forge start",
    "package": "npm run build-react && electron-forge package",
    "make": "npm run build-react && electron-forge make",
    "build-react": "esbuild renderer/renderer.jsx --bundle --outfile=renderer/dist/renderer.js --format=esm",
    "builder": "npm run build-react && electron-builder",
    "builder:win": "npm run build-react && electron-builder --win",
    "builder:linux": "npm run build-react && electron-builder --linux",
    "builder:dir": "npm run build-react && electron-builder --dir",
    "publish": "npm run build-react && electron-forge publish"
  },
  "config": {
    "forge": "./forge.config.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^25.6.0",
    "electron": "^40.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "semantic-release": "^21.0.7",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
