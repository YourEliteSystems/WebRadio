{
  "name": "webradio",
  "version": "1.0.6-beta.1",
  "description": "Plattformübergreifende WebRadio-App mit Electron",
  "main": "electron/main.js",
  "author": "Your Elite Systems",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build-react && electron .",
    "dev:watch": "esbuild renderer/renderer.jsx --bundle --outfile=renderer/dist/renderer.js --format=esm --watch",
    "build": "npm run build-react",
    "build-react": "esbuild renderer/renderer.jsx --bundle --outfile=renderer/dist/renderer.js --format=esm --minify",
    "test": "node scripts/tests/navigation.test.js && node scripts/tests/theme.test.js",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:dir": "electron-builder --dir",
    "release": "node scripts/release",
    "release:validate": "node scripts/release/validate.js",
    "release:notes": "node scripts/release/release-notes.js",
    "release:checksums": "node scripts/release/checksums.js",
    "release:detect": "node scripts/release/detect-release.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^25.6.0",
    "electron": "^40.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.9",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
