{
  "name": "webradio",
  "version": "1.0.5-rc.12",
  "description": "Plattformübergreifende WebRadio-App mit Electron",
  "main": "electron/main.js",
  "author": "Your Elite Systms",
  "scripts": {
    "dev": "npm run build-react && electron .",
    "build": "npm run build-react",
    "build-react": "esbuild renderer/renderer.jsx --bundle --outfile=renderer/dist/renderer.js --format=esm",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:dir": "electron-builder --dir",
    "release": "node scripts/release",
    "release:validate": "node scripts/release/validate.js",
    "release:notes": "node scripts/release/release-notes.js",
    "release:checksums": "node scripts/release/checksums.js",
    "release:detect": "node scripts/release/detect-release.js"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/node": "^25.6.0",
    "electron": "^40.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "semantic-release": "^21.0.7",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
